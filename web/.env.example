# ============================================================
# VibeFast — Variables de entorno
# Copia este archivo a .env.local y rellena los valores
# ============================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
# Encuentra estas keys en: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Resend (email) ---
# https://resend.com/api-keys
RESEND_API_KEY=

# --- PostHog (opcional, analytics) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Mercado Pago (MVP — links de pago por producto) ---
# Crear en: https://www.mercadopago.com.mx/herramientas-para-vender/link-de-pago
# Configurar URLs de retorno en MP:
#   Éxito:  {NEXT_PUBLIC_APP_URL}/compra/gracias?product=ID&status=approved
#   Pendiente: {NEXT_PUBLIC_APP_URL}/compra/pendiente?product=ID&status=pending
# Los links por producto se configuran en web/config.js → payments.links

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
